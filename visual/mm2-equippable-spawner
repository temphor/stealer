local skins = {}

local function refreshSkins()
    skins = {}
    for name in pairs(data) do
        skins[#skins + 1] = name
    end
    table.sort(skins, function(a, b)
        return a:lower() < b:lower()
    end)
end

refreshSkins()

local selectedSkin = skins[1]

local dropdown = tab:Dropdown({
    Title = "Select Skin",
    Values = skins,
    Value = selectedSkin,
    Multi = false,
    AllowNone = false,
    SearchBarEnabled = true,

    Callback = function(value)
        selectedSkin = value
    end
})

tab:Button({
    Title = "Spawn Selected",
    Icon = "plus",

    Callback = function()
        if selectedSkin and data[selectedSkin] then
            spawn(selectedSkin)

            WindUI:Notify({
                Title = "Spawned",
                Content = selectedSkin,
                Duration = 2
            })
        end
    end
})

tab:Button({
    Title = "Refresh",
    Icon = "refresh-cw",

    Callback = function()
        refreshSkins()
        dropdown:Refresh(skins)
    end
})
